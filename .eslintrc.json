{
  "root": true,
  "extends": ["eslint:recommended"],
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "ignorePatterns": [
    "**/*.ts",
    "**/*.tsx",
    "lib/generated/**",
    "node_modules/",
    ".next/",
    "coverage/",
    "app_backup/",
    "archive_flatten_backup/",
    "temp_excluded/",
    "__tests__/**",
    "tests/**",
    "scripts/**",
    "scripts_app/**",
    "database/**"
  ],
  "rules": {}
}

