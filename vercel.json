{
  "_comment": "Force redeploy - gemini model fix",
  "functions": {
    "app/api/cron/content-automation/route.ts": {
      "maxDuration": 300
    },
    "app/api/pdf/generate/route.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/cron/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/content-automation?action=all", "schedule": "0 * * * *" }
  ]
}
