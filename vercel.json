{
  "functions": {
    "app/api/cron/auto-blog/route.ts": {
      "maxDuration": 60
    },
    "app/api/pdf/generate/route.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/cron/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/auto-blog",
      "schedule": "0 10 * * 1,4"
    }
  ]
}

