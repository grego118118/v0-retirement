{
  "headers": [
    {
      "source": "/api/cron/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/auto-blog",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron/rank-loop",
      "schedule": "0 13 * * *"
    }
  ]
}

