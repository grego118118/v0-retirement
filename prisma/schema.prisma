model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@schema("public")
}

model EmailLog {
  id         String   @id @default(cuid())
  userId     String
  type       String
  recipients String
  success    Boolean
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([type])
  @@index([userId])
  @@schema("public")
}

model RetirementCalculation {
  id                 String   @id @default(cuid())
  userId             String
  calculationName    String?
  retirementDate     DateTime
  retirementAge      Int
  yearsOfService     Float
  averageSalary      Float
  retirementGroup    String
  benefitPercentage  Float
  retirementOption   String
  monthlyBenefit     Float
  annualBenefit      Float
  benefitReduction   Float?
  survivorBenefit    Float?
  socialSecurityData String?
  notes              String?
  isFavorite         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())
  User               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
  @@schema("public")
}

model RetirementProfile {
  id                             String    @id @default(cuid())
  userId                         String    @unique
  dateOfBirth                    DateTime
  membershipDate                 DateTime
  retirementGroup                String
  benefitPercentage              Float
  currentSalary                  Float
  averageHighest3Years           Float?
  yearsOfService                 Float?
  retirementDate                 DateTime?
  retirementOption               String?
  estimatedSocialSecurityBenefit Float?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @default(now())
  User                           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("public")
}

model User {
  id                         String                  @id @default(cuid())
  email                      String                  @unique
  name                       String?
  image                      String?
  emailVerified              DateTime?
  retirementDate             DateTime?
  stripeCustomerId           String?
  subscriptionId             String?
  subscriptionStatus         String?
  subscriptionPlan           String?
  currentPeriodEnd           DateTime?
  cancelAtPeriodEnd          Boolean                 @default(false)
  trialEnd                   DateTime?
  socialSecurityCalculations Int                     @default(0)
  wizardUses                 Int                     @default(0)
  pdfReports                 Int                     @default(0)
  lastUsageReset             DateTime?
  emailPreferences           String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @default(now())
  Account                    Account[]
  EmailLog                   EmailLog[]
  RetirementCalculation      RetirementCalculation[]
  RetirementProfile          RetirementProfile?
  Session                    Session[]
  blogPosts                  BlogPost[]

  @@schema("public")
}

