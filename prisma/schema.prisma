model identities {
  provider_id     String
  user_id         String     @db.Uuid
  identity_data   Json
  provider        String
  last_sign_in_at DateTime?  @db.Timestamptz(6)
  created_at      DateTime?  @db.Timestamptz(6)
  updated_at      DateTime?  @db.Timestamptz(6)
  /// CI-only: simplified to nullable without default to avoid column-reference DEFAULT in prisma db push.
  /// In production, Supabase manages any derived email defaults for identities.
  email           String?
