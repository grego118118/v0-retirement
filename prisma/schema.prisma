// Blog System Models for Massachusetts Retirement System
model BlogPost {
  id                    String   @id @default(cuid())
  title                 String
  slug                  String   @unique
  content               String
  excerpt               String?
  status                String   @default("draft") // draft, published, archived
  isAiGenerated         Boolean  @default(false)
  aiModel               String?
  seoKeywords           String[]
  metaDescription       String?
  featuredImage         String?
  featuredImageUrl      String?
  viewCount             Int      @default(0)
  qualityScore          Float?
  contentQualityScore   Float?
  publishedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  authorId              String?

  // AI-related fields
  aiModelUsed           String?
  aiGenerationPrompt    String?
  aiGenerationCost      Float?

  // SEO fields
  seoTitle              String?
  seoDescription        String?
  seoOptimized          Boolean  @default(false)
  internalLinksAdded    Boolean  @default(false)

  // Content management fields
  factCheckStatus       String?  @default("pending") // pending, approved, needs_review, rejected
  scheduledPublishAt    DateTime?
  autoGeneratedTags     String[]

  // Relations
  categories            BlogPostCategory[]
  reviews               ContentReview[]
  author                User?             @relation(fields: [authorId], references: [id])

  @@map("blog_posts")
  @@schema("public")
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isAiTopic   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  posts       BlogPostCategory[]

  @@map("blog_categories")
  @@schema("public")
}

model BlogPostCategory {
  id         String      @id @default(cuid())
  postId     String
  categoryId String

  // Relations
  post       BlogPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([postId, categoryId])
  @@map("blog_post_categories")
  @@schema("public")
}

model AiContentJob {
  id                    String   @id @default(cuid())
  jobType               String   // scheduled_post, topic_research, content_update, seo_optimization
  status                String   @default("pending") // pending, running, completed, failed, cancelled
  topic                 String
  categoryId            String?
  targetPublishDate     DateTime?
  aiModel               String
  generationPrompt      String?
  generatedPostId       String?
  errorMessage          String?
  costEstimate          Float?
  actualCost            Float?
  executionTimeSeconds  Int?
  createdAt             DateTime @default(now())
  startedAt             DateTime?
  completedAt           DateTime?
  createdBy             String?

  @@map("ai_content_jobs")
  @@schema("public")
}

model AiUsageCost {
  id              String   @id @default(cuid())
  date            DateTime
  serviceProvider String   // openai, anthropic, stability, google
  serviceType     String   // text_generation, image_generation, fact_checking
  tokensUsed      Int?
  apiCalls        Int      @default(0)
  costUsd         Float
  postId          String?
  jobId           String?
  createdAt       DateTime @default(now())

  @@map("ai_usage_costs")
  @@schema("public")
}

model ContentReview {
  id                    String   @id @default(cuid())
  postId                String
  reviewerId            String?
  status                String   @default("pending") // pending, approved, rejected, needs_revision
  reviewStatus          String   @default("pending") // pending, approved, rejected, needs_revision
  reviewNotes           String?
  qualityScore          Float?
  contentQualityRating  Float?
  factCheckNotes        String?
  factCheckCompleted    Boolean  @default(false)
  seoNotes              String?
  seoCheckCompleted     Boolean  @default(false)
  suggestedChanges      String?
  reviewedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  post                  BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("content_reviews")
  @@schema("public")
}

model NewsletterSubscriber {
  id              String   @id @default(cuid())
  email           String   @unique
  isActive        Boolean  @default(true)
  subscribedAt    DateTime @default(now())
  unsubscribedAt  DateTime?
  source          String?  // website, api, import, etc.
  preferences     String[] // topics they're interested in

  @@map("newsletter_subscribers")
  @@schema("public")
}
