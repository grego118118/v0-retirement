# MassPension environment variables
# Copy to .env.local for development. CI copies this file to .env.test and
# overrides DATABASE_URL/NEXTAUTH_* itself — placeholders here must be inert.

# --- Core ---
DATABASE_URL=postgresql://user:password@localhost:5432/masspension
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# --- Supabase (blog storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_ANNUAL=
# One-time $39 Complete Retirement Report price id (price_...)
NEXT_PUBLIC_STRIPE_PRICE_REPORT=

# --- Email (Resend preferred; SMTP fallback) ---
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Content pipeline ---
GEMINI_API_KEY=
CRON_SECRET=
ADMIN_EMAILS=
CONTENT_REVIEWER_EMAILS=
LEAD_NOTIFICATION_EMAIL=

# --- Analytics / Ads ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_BANNER_SLOT=
NEXT_PUBLIC_ADSENSE_SQUARE_SLOT=
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=
NEXT_PUBLIC_ADSENSE_RESPONSIVE_SLOT=
