# Massachusetts Retirement System - environment template
# Copy to .env.local and fill in real values. NEVER commit real credentials.

# Database (Supabase Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/dev_db

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin access (comma-separated emails granted the admin role)
ADMIN_EMAILS=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# AI content generation
GEMINI_API_KEY=

# Cron / seeding auth
CRON_SECRET=
SEED_SECRET=

# Supabase (public keys are safe for the browser; service role key is NOT)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AdSense (optional)
NEXT_PUBLIC_ADSENSE_BANNER_SLOT=
NEXT_PUBLIC_ADSENSE_SQUARE_SLOT=
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=
NEXT_PUBLIC_ADSENSE_RESPONSIVE_SLOT=
